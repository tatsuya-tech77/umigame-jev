# TypeSafe AI (Jev) の APIキー
TYPESAFE_API_KEY=apikey_xxxxxxxxxxxxxxxx

# 省略可
# TYPESAFE_DEFAULT_MODEL=jev-latest

# 1 にすると API を呼ばずに動く（画面の確認用。答えはでたらめ）
# JEV_MOCK=1

# 公開するときの守り（既定値）
# UMIGAME_PER_IP_PER_MIN=60          # 1つの IP から1分間に受け付ける回数（質問1回で2回使うことがある）
# UMIGAME_TRUST_PROXY_HOPS=1         # Render・Cloud Run など中継サーバーの後ろで動かすときだけ 1（IP を X-Forwarded-For から取る）
# UMIGAME_DAILY_BUDGET_YEN=100       # 全員合計の1日の利用料の上限（円）。超えたらその日は店じまい

# AI 対戦（umigame.arena）用。OpenRouter のキー1つで各社のモデルを呼ぶ
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# UMIGAME_SAMPLE_AI=1                # まだ測っていない AI の「仮」の成績を表に足す（見た目の確認用。勝ち負けには使わない）
